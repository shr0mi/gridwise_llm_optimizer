# Copy to .env and fill in. NEVER commit the real file (.gitignore covers it).
# Every value below is a NAME ONLY -- no secrets belong in this repo.

# --- LLM provider (Google AI Studio, FREE tier is enough) -------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: several free keys, comma-separated. They are round-robined, which
# multiplies the free-tier requests-per-minute headroom.
GEMINI_API_KEYS=
# Primary model, then the chain tried when a per-model free-tier cap is hit.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash

# --- interpretation behaviour ----------------------------------------------
LLM_TIMEOUT_S=12          # per model call
LLM_MAX_ATTEMPTS=3        # retries across keys/models on 429 or 5xx
LLM_MAX_CONCURRENCY=4     # stay under the free-tier RPM ceiling
LLM_ARBITER=1             # 1 = one extra call when rules and model disagree
LLM_CACHE_SIZE=20000      # normalized operator-note cache entries
LLM_BREAKER_THRESHOLD=4   # consecutive failures before the breaker opens
LLM_BREAKER_COOLDOWN_S=30

# --- service ----------------------------------------------------------------
REQUEST_BUDGET_S=25       # whole request; the judge limit is 30s
SCENARIO_CACHE_SIZE=2000
SCENARIO_CACHE_TTL_S=3600
LOG_LEVEL=INFO
PORT=8000
WEB_CONCURRENCY=2
