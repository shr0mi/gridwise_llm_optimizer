# Copy to .env and fill in. NEVER commit the real file (.gitignore covers it).
# Every value below is a NAME ONLY -- no secrets belong in this repo.

# --- provider chain ----------------------------------------------------------
# The primary provider, then the providers to fall back to when it is out of
# quota or down. Key pools, breakers and cooldowns are tracked per provider.
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDERS=gemini

# --- OpenAI (primary) --------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Comma-separated pool is supported here too.
OPENAI_API_KEYS=
LLM_MODEL=gpt-5.4-mini
LLM_FALLBACK_MODELS=gpt-5.4-nano

# --- Gemini (fallback provider, FREE tier is enough) ------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: several free keys, comma-separated. They are round-robined, which
# multiplies the free-tier requests-per-minute headroom.
GEMINI_API_KEYS=
# Primary model, then the chain tried when a per-model free-tier cap is hit.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite

# --- optional second provider (set LLM_PROVIDER=anthropic to use it) --------
ANTHROPIC_API_KEY=
# Defaults when LLM_PROVIDER=anthropic: claude-haiku-4-5, then claude-sonnet-5.
# LLM_MODEL / LLM_FALLBACK_MODELS override the chain for either provider.
LLM_MODEL=
LLM_FALLBACK_MODELS=

# --- interpretation behaviour ----------------------------------------------
LLM_TIMEOUT_S=8
LLM_TOTAL_BUDGET_S=10          # per model call
LLM_MAX_ATTEMPTS=3        # retries across keys/models on 429 or 5xx
LLM_MAX_CONCURRENCY=4
LLM_MODEL_COOLDOWN_S=60     # stay under the free-tier RPM ceiling
LLM_ARBITER=1             # 1 = one extra call when rules and model disagree
LLM_CACHE_SIZE=20000      # normalized operator-note cache entries
LLM_BREAKER_THRESHOLD=4   # consecutive failures before the breaker opens
LLM_BREAKER_COOLDOWN_S=30

# --- service ----------------------------------------------------------------
REQUEST_BUDGET_S=25       # whole request; the judge limit is 30s
SCENARIO_CACHE_SIZE=2000
SCENARIO_CACHE_TTL_S=3600
LOG_LEVEL=INFO
PORT=8000
WEB_CONCURRENCY=2
